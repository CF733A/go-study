{
    "swagger": "2.0",
    "info": {
        "description": "Сервис для геокодирования адресов с аутентификацией JWT",
        "title": "GEO Service API",
        "contact": {
            "name": "API Support",
            "url": "http://localhost:8080",
            "email": "support@geo-service.com"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Возвращает информацию о сервисе в JSON или текстовом формате",
                "produces": [
                    "application/json",
                    "text/plain"
                ],
                "tags": [
                    "info"
                ],
                "summary": "Главная страница API",
                "responses": {
                    "200": {
                        "description": "Информация о сервисе в текстовом формате",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/address/geocode": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Обратное геокодирование: преобразование координат в адрес",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geo"
                ],
                "summary": "Поиск адреса по координатам",
                "parameters": [
                    {
                        "description": "Координаты для поиска",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/geo.GeocodeRequestDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешное геокодирование",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/responder.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/geo.GeocodeResponseDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Ошибка валидации",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    },
                    "401": {
                        "description": "Неавторизован",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    },
                    "500": {
                        "description": "Ошибка геокодирования",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    }
                }
            }
        },
        "/api/address/search": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Прямое геокодирование: преобразование адреса в координаты",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geo"
                ],
                "summary": "Поиск координат по адресу",
                "parameters": [
                    {
                        "description": "Адрес для поиска",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/geo.SearchRequestDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный поиск",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/responder.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/geo.SearchResponseDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Ошибка валидации",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    },
                    "401": {
                        "description": "Неавторизован",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    },
                    "500": {
                        "description": "Ошибка геокодирования",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "description": "Вход в систему и получение JWT токена",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Аутентификация пользователя",
                "parameters": [
                    {
                        "description": "Данные для входа",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешная аутентификация",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/responder.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.LoginResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Неверные учетные данные",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    }
                }
            }
        },
        "/api/register": {
            "post": {
                "description": "Создание нового пользователя в системе",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "Данные для регистрации",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешная регистрация",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/responder.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.RegisterResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Ошибка валидации",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/responder.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "securepassword123"
                },
                "username": {
                    "type": "string",
                    "example": "john_doe"
                }
            }
        },
        "auth.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "securepassword123"
                },
                "username": {
                    "type": "string",
                    "example": "john_doe"
                }
            }
        },
        "auth.RegisterResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "user created successfully"
                }
            }
        },
        "geo.AddressResponseDTO": {
            "type": "object",
            "properties": {
                "city_area": {
                    "type": "string",
                    "example": "Северо-восточный"
                },
                "city_district": {
                    "type": "string",
                    "example": "Северное Медведково"
                },
                "country": {
                    "type": "string",
                    "example": "Россия"
                },
                "geo_lat": {
                    "type": "number",
                    "example": 55.8782557
                },
                "geo_lon": {
                    "type": "number",
                    "example": 37.65372
                },
                "house": {
                    "type": "string",
                    "example": "11"
                },
                "postal_code": {
                    "type": "string",
                    "example": "127642"
                },
                "region": {
                    "type": "string",
                    "example": "Москва"
                },
                "result": {
                    "type": "string",
                    "example": "г Москва, ул Сухонская, д 11"
                },
                "source": {
                    "type": "string",
                    "example": "москва сухонская 11"
                },
                "street": {
                    "type": "string",
                    "example": "Сухонская"
                }
            }
        },
        "geo.GeocodeRequestDTO": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "string",
                    "example": "55.7558"
                },
                "lng": {
                    "type": "string",
                    "example": "37.6173"
                }
            }
        },
        "geo.GeocodeResponseDTO": {
            "type": "object",
            "properties": {
                "suggestions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/geo.SuggestionDTO"
                    }
                }
            }
        },
        "geo.SearchRequestDTO": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "example": "Москва, Красная площадь"
                }
            }
        },
        "geo.SearchResponseDTO": {
            "type": "object",
            "properties": {
                "addresses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/geo.AddressResponseDTO"
                    }
                }
            }
        },
        "geo.SuggestionDTO": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/geo.SuggestionDataDTO"
                },
                "unrestricted_value": {
                    "type": "string",
                    "example": "г Москва, ул Сухонская, д 11"
                },
                "value": {
                    "type": "string",
                    "example": "г Москва, ул Сухонская, д 11"
                }
            }
        },
        "geo.SuggestionDataDTO": {
            "type": "object",
            "properties": {
                "city_area": {
                    "type": "string",
                    "example": "Северо-восточный"
                },
                "city_district": {
                    "type": "string",
                    "example": "Северное Медведково"
                },
                "country": {
                    "type": "string",
                    "example": "Россия"
                },
                "geo_lat": {
                    "type": "number",
                    "example": 55.8782557
                },
                "geo_lon": {
                    "type": "number",
                    "example": 37.65372
                },
                "house": {
                    "type": "string",
                    "example": "11"
                },
                "postal_code": {
                    "type": "string",
                    "example": "127642"
                },
                "region": {
                    "type": "string",
                    "example": "Москва"
                },
                "street": {
                    "type": "string",
                    "example": "Сухонская"
                }
            }
        },
        "home.HomeResponse": {
            "type": "object",
            "properties": {
                "documentation": {
                    "type": "string"
                },
                "endpoints": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "message": {
                    "type": "string"
                },
                "service": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "responder.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите: Bearer {JWT_TOKEN}",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}